# =====================================================================
# FRMA · Variables de entorno
# Copia este archivo como `.env.local` (en tu computador) o cárgalas en
# Vercel → Project → Settings → Environment Variables.
# NUNCA subas `.env.local` a GitHub. Todas son opcionales: si faltan,
# el sitio funciona igual (sin esa integración).
# Las que empiezan con NEXT_PUBLIC_ se incrustan al compilar: si las
# cambias en Vercel, vuelve a desplegar (Redeploy).
# =====================================================================

# --- Sitio ---
# URL pública final, sin "/" al final. Ej: https://frma.cl
NEXT_PUBLIC_SITE_URL=
# Correo de contacto visible en el sitio
NEXT_PUBLIC_CONTACT_EMAIL=
# URL de Instagram (opcional). Ej: https://instagram.com/frma.cl
NEXT_PUBLIC_INSTAGRAM_URL=

# --- Google Analytics 4 --- formato: G-XXXXXXXXXX
NEXT_PUBLIC_GA4_ID=

# --- Meta Pixel --- solo números. Ej: 123456789012345
NEXT_PUBLIC_META_PIXEL_ID=

# --- Microsoft Clarity --- ID del proyecto (letras y números). Ej: abcd1234ef
NEXT_PUBLIC_CLARITY_ID=

# true = muestra cada evento en la consola del navegador y activa DebugView de GA4.
# Úsalo solo para pruebas; déjalo en false en producción.
NEXT_PUBLIC_ANALYTICS_DEBUG=false

# false = desactiva la medición propia del embudo (tabla funnel_events en Supabase).
NEXT_PUBLIC_FIRST_PARTY_EVENTS=true

# --- Supabase (leads, medición propia y acceso al panel /admin) ---
# Project Settings → API (o "API Keys")
NEXT_PUBLIC_SUPABASE_URL=
# Clave pública: "anon" (legacy) o "publishable" (sb_publishable_...). Es segura en el navegador.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave SECRETA: "service_role" (legacy) o "secret" (sb_secret_...).
# Solo en el servidor. NUNCA le pongas el prefijo NEXT_PUBLIC_ ni la compartas.
SUPABASE_SERVICE_ROLE_KEY=

# --- Panel de administración ---
# Correos autorizados a entrar a /admin/experiment, separados por coma.
ADMIN_EMAILS=
